        "import numpy as np\n",
        "from sklearn.metrics import confusion_matrix\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "actual = np.array(['Dog', 'Dog', 'Dog', 'Not Dog', 'Dog', 'Not Dog', 'Dog', 'Dog', 'Not Dog', 'Not Dog'])\n",
        "predicted = np.array(['Dog', 'Not Dog', 'Dog', 'Not Dog', 'Dog', 'Dog', 'Dog', 'Dog', 'Not Dog', 'Not Dog'])\n",
        "\n",
        "# Explicitly define labels to ensure correct alignment in the confusion matrix\n",
        "labels = ['Dog', 'Not Dog']\n",
        "conf_matrix = confusion_matrix(actual, predicted, labels=labels)\n",
        "\n",
        "sns.heatmap(\n",
        "    conf_matrix,\n",
        "    annot=True,\n",
        "    fmt='g',\n",
        "    xticklabels=labels,\n",
        "    yticklabels=labels,\n",
        "    cmap='RdPu'\n",
        ")\n",
        "\n",
        "plt.ylabel(\"Prediction\", fontsize=16)\n",
        "plt.xlabel(\"Actual\", fontsize=16)\n",
        "plt.title(\"Confusion Matrix\", fontsize=20)\n",
        "plt.show()"
      ]
    },
